generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  phone            String?
  role             String    @default("student")
  hidden           Boolean   @default(false)
  languagePref     String    @default("sv")
  bookings         Booking[]
  checkIns         Booking[] @relation("BookingCheckedInBy")
  schoolBookings   Booking[] @relation("BookingSchoolUser")
  assignedSessions Session[] @relation("AssignedSchoolSessions")
  schoolCoursePrices SchoolCoursePrice[]
  schoolAllocations  SessionSchoolAllocation[] @relation("SchoolAllocations")
  createdAt        DateTime  @default(now())
}

// Används som filial (plats/kontor) i admin
model School {
  id           Int       @id @default(autoincrement())
  name         String
  address      String
  city         String    @default("")
  bana         String    @default("") // banans namn i rapporten till Transportstyrelsen
  contactEmail String
  active       Boolean   @default(true)
  sessions     Session[]
  students     Student[]
}

model Student {
  id               Int       @id @default(autoincrement())
  firstName        String
  lastName         String
  personnummerEnc  String?
  personnummerHash String?   @unique
  email            String    @default("")
  phone            String    @default("")
  address          String    @default("")
  postalCode       String    @default("")
  city             String    @default("")
  behorighet       String    @default("B")
  status           String    @default("active") // active | archived
  filialId         Int?
  filial           School?   @relation(fields: [filialId], references: [id], onDelete: SetNull)
  permitValidUntil DateTime?
  synintygDate     DateTime?
  risk1DoneAt      DateTime?
  risk2DoneAt      DateTime?
  gdprInformedAt   DateTime?
  notes            String    @default("")
  bookings         Booking[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Course {
  id          Int       @id @default(autoincrement())
  titleSv     String
  titleEn     String
  description String
  type        String
  vehicle     String
  behorighet  String    @default("B")
  price          Int
  location       String    @default("")
  receiptMessage String    @default("")
  sessions       Session[]
  schoolPrices   SchoolCoursePrice[]
}

model SchoolCoursePrice {
  id           Int    @id @default(autoincrement())
  schoolUserId Int
  schoolUser   User   @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  price        Int
  @@unique([schoolUserId, courseId])
}

model Session {
  id                   Int       @id @default(autoincrement())
  courseId             Int
  course               Course    @relation(fields: [courseId], references: [id])
  schoolId             Int
  school               School    @relation(fields: [schoolId], references: [id])
  startTime            DateTime
  endTime              DateTime
  seatLimit            Int
  seatsAvailable       Int
  discountPrice        Int?
  visibility           String    @default("public")
  receiptMessage       String    @default("")
  status               String    @default("planned") // planned | completed | canceled
  reportToTS           Boolean   @default(true)
  reportedAt           DateTime?
  internalNotes        String    @default("")
  comboRisk1SessionId  Int?
  comboRisk2SessionId  Int?
  comboRisk1Session    Session?  @relation("ComboR1", fields: [comboRisk1SessionId], references: [id])
  comboRisk2Session    Session?  @relation("ComboR2", fields: [comboRisk2SessionId], references: [id])
  usedAsComboR1        Session[] @relation("ComboR1")
  usedAsComboR2        Session[] @relation("ComboR2")
  assignedSchoolUsers  User[]    @relation("AssignedSchoolSessions")
  bookings             Booking[]
  schoolAllocations    SessionSchoolAllocation[]
}

model SessionSchoolAllocation {
  id             Int     @id @default(autoincrement())
  sessionId      Int
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schoolUserId   Int
  schoolUser     User    @relation("SchoolAllocations", fields: [schoolUserId], references: [id], onDelete: Cascade)
  allocatedSeats Int
  meetingPlace   String    @default("") // skolans egen mötesplats, annars kursens
  fillBy         DateTime? // outnyttjade platser släpps efter detta
  message        String    @default("")
  notifiedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  @@unique([sessionId, schoolUserId])
}

model Booking {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  session      Session  @relation(fields: [sessionId], references: [id])
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  studentId    Int?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  guestName    String?
  personnummer String?
  guestPhone   String?
  guestEmail   String?
  note         String?  // anteckning från skolan eller admin, t.ex. "behöver tolk"
  bookingTime          DateTime @default(now())
  status               String   @default("Pending")
  bookedByRole         String   @default("student")
  bookedBySchoolUserId Int?
  bookedBySchoolUser   User?    @relation("BookingSchoolUser", fields: [bookedBySchoolUserId], references: [id])
  reminderSentAt       DateTime?
  emailReminderSentAt  DateTime?
  result               String?
  resultNote           String?
  attendance           String   @default("registered") // registered | attended | no_show | late_cancel
  checkedInAt          DateTime?
  checkedInById        Int?
  checkedInBy          User?    @relation("BookingCheckedInBy", fields: [checkedInById], references: [id])
  idType               String?  // korkort | pass | nationellt_id | id_kort
  payment              Payment?

  @@index([studentId])
}

// Kopia av varje incheckning på riskutbildning. Sparas i fem år, även om eleven raderas.
model RiskRegisterEntry {
  id              Int      @id @default(autoincrement())
  bookingId       Int?
  studentId       Int?
  sessionId       Int?
  courseType      String
  courseTitle     String
  sessionDate     DateTime
  studentName     String
  personnummerEnc String
  idType          String
  checkedInAt     DateTime
  checkedInById   Int?
  checkedInByName String
  createdAt       DateTime @default(now())

  @@index([sessionDate])
}

// Engångskod via e-post innan register med personnummer får laddas ner
model ExportCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ExportLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String
  kind      String
  period    String   @default("")
  createdAt DateTime @default(now())
}

model InstructorInvite {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  email     String
  name      String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amount        Int
  provider      String
  status        String   @default("Pending")
  transactionId String?
  createdAt     DateTime @default(now())
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model CourseGroup {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model WhatsappNumber {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model WhatsappConversation {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  state     String   @default("idle")
  data      Json?
  updatedAt DateTime @updatedAt
}

model InfoCard {
  id                 Int      @id @default(autoincrement())
  badge              String   @default("")
  title              String
  description        String
  price              String   @default("")
  imageUrl           String   @default("")
  videoUrl           String   @default("")
  primaryButtonText  String   @default("Läs mer")
  primaryButtonLink  String   @default("/courses")
  secondaryButtonText String  @default("")
  secondaryButtonLink String  @default("")
  sortOrder          Int      @default(0)
  visible            Boolean  @default(true)
  createdAt          DateTime @default(now())
}
